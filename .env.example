# Local development defaults to SQLite when DATABASE_URL is omitted.
#
# Vercel Preview/Production:
# Use the Supabase Transaction Pooler connection string (port 6543).
# The app normalizes postgres:// / postgresql:// to SQLAlchemy psycopg v3.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Reserved for migrations/admin work later. Use a direct/session connection,
# never expose this variable to browser code.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
